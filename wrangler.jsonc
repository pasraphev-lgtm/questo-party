{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "questo-party",
  "main": "worker.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "vars": {
    "ALLOWED_ORIGINS": "https://orange-sea-cf7a.pasraphev.workers.dev"
  },
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "PartyRoom" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["PartyRoom"] }],
  "ratelimits": [
    { "name": "CREATE_LIMIT", "namespace_id": "711701", "simple": { "limit": 20, "period": 60 } },
    { "name": "JOIN_LIMIT", "namespace_id": "711702", "simple": { "limit": 120, "period": 60 } }
  ]
}
